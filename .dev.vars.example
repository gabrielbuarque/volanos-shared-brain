AUTH_TOKEN=your_memorable_token_here
# Server-side Composio project key. Provider OAuth tokens stay in Composio.
COMPOSIO_API_KEY=your_composio_project_key_here
# Optional when the local Worker is exposed through a public HTTPS tunnel.
# COMPOSIO_CALLBACK_URL=https://your-tunnel.example/integrations/oauth/callback

# ── Shared Brain pilot ──
# Text generation providers. Each is skipped when its key is absent; Workers AI is the reserve.
# OPENROUTER_API_KEY=sk-or-...
# NVIDIA_API_KEY=nvapi-...
# Jev (TypeSafe) classifies every ingested chunk P0-P12. Without it /bulk-ingest keeps the
# one-explicit-level-per-file behaviour.
# JEV_API_KEY=...
# Google Workspace sign-in (OAuth client of type "Web"; redirect URI: <origin>/auth/google/callback).
# Jev reranker for /recall (falls back to JEV_API_KEY). Turn it on with config RERANKER=jev.
# TYPESAFE_API_KEY=...
# Markdown export to a PRIVATE GitHub repository (contains P0). Set config EXPORT_REPO to enable.
# GITHUB_EXPORT_TOKEN=github_pat_...
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
